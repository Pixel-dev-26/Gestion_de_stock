{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    { "src": "^/$", "dest": "/accueil.html" },
    { "src": "^/accueil.html$", "dest": "/accueil.html" },
    { "src": "^/connexion.html$", "dest": "/connexion.html" },
    { "src": "^/instock-dashboard/?$", "dest": "/instock-dashboard/dashboard.html" }
  ]
}
